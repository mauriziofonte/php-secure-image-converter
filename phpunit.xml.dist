<?xml version="1.0" encoding="UTF-8"?>
<!--
    Valid for PHPUnit 8.5, 9.6, 10.5 and 11.5: no schema location and only elements and attributes that all four
    versions understand. Deprecations are made fatal by the error handler installed in tests/bootstrap.php.
-->
<phpunit
    bootstrap="tests/bootstrap.php"
    colors="true"
    beStrictAboutOutputDuringTests="true"
    beStrictAboutTestsThatDoNotTestAnything="true"
    failOnRisky="true"
    failOnWarning="true"
>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
