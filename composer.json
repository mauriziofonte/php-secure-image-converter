{
  "name": "mfonte/secure-image-converter",
  "description": "Turns untrusted images into web-optimised WEBP and AVIF files with input validation, isolated decoding and output verification.",
  "type": "library",
  "license": "BSD-3-Clause",
  "keywords": [
    "image",
    "webp",
    "avif",
    "conversion",
    "security",
    "sandbox"
  ],
  "authors": [
    {
      "name": "Maurizio Fonte",
      "homepage": "https://github.com/mauriziofonte"
    }
  ],
  "require": {
    "php": "^7.2.5 || ^8.0",
    "psr/log": "^1.1 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^8.5.52 || ^9.6.33 || ^10.5.62 || ^11.5.50",
    "yoast/phpunit-polyfills": "^2.0.1 || ^4.0"
  },
  "autoload": {
    "psr-4": {
      "Mfonte\\SecureImageConverter\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mfonte\\SecureImageConverter\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": "@php vendor/bin/phpunit",
    "analyse": [
      "@php tools/ensure-tool.php phpstan",
      "@php tools/phpstan/vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=1G",
      "@php tools/phpstan/vendor/bin/phpstan analyse --configuration=phpstan-php85.neon.dist --no-progress --memory-limit=1G"
    ],
    "cs:check": [
      "@php tools/ensure-tool.php php-cs-fixer",
      "@php tools/php-cs-fixer/vendor/bin/php-cs-fixer fix --dry-run --diff --verbose"
    ],
    "cs:fix": [
      "@php tools/ensure-tool.php php-cs-fixer",
      "@php tools/php-cs-fixer/vendor/bin/php-cs-fixer fix --verbose"
    ],
    "ci": [
      "@cs:check",
      "@analyse",
      "@test"
    ]
  },
  "scripts-descriptions": {
    "test": "Run the PHPUnit test suite.",
    "analyse": "Run PHPStan at max level for PHP 7.2.5 and for PHP 8.5 (requires tools/phpstan).",
    "cs:check": "Report coding style violations without changing files (requires tools/php-cs-fixer).",
    "cs:fix": "Fix coding style violations in place (requires tools/php-cs-fixer).",
    "ci": "Run cs:check, analyse and test, in this order."
  }
}
